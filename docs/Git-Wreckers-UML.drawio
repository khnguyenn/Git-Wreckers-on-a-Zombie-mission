text-align:center&quot;&gt;&lt;b&gt;NoTargetException&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ NoTargetException(message: String)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="730" width="330" height="96" as="geometry" /></mxCell><mxCell id="c-Exception" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Exception&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="900" width="330" height="96" as="geometry" /></mxCell><mxCell id="note" value="Relationships reflect the current Java source. Military extends Human; zombie contact deactivates a human; no replacement zombie is created." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#b8915a;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1170" width="700" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>