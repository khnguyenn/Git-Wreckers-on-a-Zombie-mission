gt;&lt;br&gt;+ update(): void&lt;br&gt;+ removeInactiveEntities(): void&lt;br&gt;+ reset(): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="330" height="236" as="geometry" /></mxCell><mxCell id="c-Main" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ main(args: String[]): void&lt;br&gt;- showSettingsDialog(): SimulationSettings&lt;br&gt;- startSimulation(settings): void&lt;br&gt;- populateWorld(world, settings): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="330" height="156" as="geometry" /></mxCell><mxCell id="c-SimPanel" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;SimPanel&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- world: World&lt;br&gt;- started, paused: boolean&lt;br&gt;- speedLevel: int&lt;hr&gt;+ isRunning(): boolean&lt;br&gt;+ getTimerDelay(): int&lt;br&gt;# paintComponent(g: Graphics): void&lt;br&gt;- setupKeyBindings(): void&lt;br&gt;- findEntities(type): List&lt;T&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="330" height="216" as="geometry" /></mxCell><mxCell id="c-Human" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Human&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- energy: double&lt;br&gt;- hidden: boolean&lt;br&gt;- shelter: Building&lt;hr&gt;+ getEnergy(): double&lt;br&gt;+ eat(food: Food): boolean&lt;br&gt;+ enterBuilding(building): boolean&lt;br&gt;+ leaveBuilding(): void&lt;br&gt;+ infect(): void&lt;br&gt;+ update(world): void&lt;br&gt;+ draw(g): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="500" width="330" height="256" as="geometry" /></mxCell><mxCell id="c-Zombie" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Zombie&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- target: Human&lt;br&gt;- directionX, directionY: double&lt;hr&gt;+ getTarget(): Human&lt;br&gt;+ findTarget(world): Human&lt;br&gt;+ infect(human: Human): void&lt;br&gt;+ update(world): void&lt;br&gt;+ draw(g): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="500" width="330" height="196" as="geometry" /></mxCell><mxCell id="c-Military" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Military&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- currentBehaviour: MovementBehaviour&lt;br&gt;- target: Zombie&lt;br&gt;- fireCooldown, kills: int&lt;hr&gt;+ getTarget(): Zombie&lt;br&gt;+ getKills(): int&lt;br&gt;+ getBehaviourName(): String&lt;br&gt;+ update(world): void&lt;br&gt;+ shoot(): void throws NoTargetException&lt;br&gt;+ draw(g): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="850" width="330" height="236" as="geometry" /></mxCell><mxCell id="c-Food" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Food&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;- energyValue: double&lt;br&gt;- ageInTicks: int&lt;hr&gt;+ getEnergyValue(): double&lt;br&gt;+ isConsumed(): boolean&lt;br&gt;+ consume(): void&lt;br&gt;+ update(world): void&lt;br&gt;+ draw(g): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.5;fontFamily=Arial;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="800" width="330" height="196" as="geometry" /></mxCell><mxCell id="c-Building" value="&lt;div style=&quot;text-